{"transcript":"nisayon","exists":true,"definitions":["מקרה שבו אדם או דבר נבחנים או נבדקים.","ידע או מיומנות שנרכשו לאורך זמן באמצעות עשייה או התנסות.","ניסיון מדעי או מעבדה.","פיתוי או אתגר מוסרי."],"examples":["הוא עבר ניסיון קשה.","יש לו ניסיון רב בתחום.","הם ערכו ניסיון במעבדה.","הוא עמד בניסיון ולא נכנע."],"lemma":"ניסיון","lemmaPos":"noun","synonyms":["מבחן","התנסות","בדיקה","פיתוי"],"number":"singular","pluralForm":"הניסיונות","gender":"masculine","source":"ניסיון"}