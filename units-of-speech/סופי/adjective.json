{"transcript":"sofi","exists":true,"definitions":["אחרון, קובע, שאין אחריו דבר.","ששייך לסוף, המציין את הסוף.","מוגבל, בעל גבולות, לא אינסופי."],"examples":["ההחלטה הסופית התקבלה אתמול.","השלב הסופי של הפרויקט.","לכל דבר סופי יש התחלה."],"lemma":"סופי","lemmaPos":"adjective","synonyms":["אחרון","גמור","מוחלט"],"number":"singular","gender":"masculine","source":"סופי"}